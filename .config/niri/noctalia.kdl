layout {

    focus-ring {
        active-color   "#bfc0de"
        inactive-color "#212226"
        urgent-color   "#debfbf"
    }

    border {
        active-color   "#bfc0de"
        inactive-color "#212226"
        urgent-color   "#debfbf"
    }


    tab-indicator {
        active-color   "#bfc0de"
        inactive-color "#50515d"
        urgent-color   "#debfbf"
    }

    insert-hint {
        color "#bfc0de80"
    }
}

recent-windows {
    highlight {
        active-color "#bfc0de"
        urgent-color "#debfbf"
    }
}
