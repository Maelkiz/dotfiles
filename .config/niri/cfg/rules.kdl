window-rule {
    geometry-corner-radius 15
    clip-to-geometry true
    draw-border-with-background false
    open-focused true
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

window-rule {
    match app-id="^firefox$"
    open-on-workspace "browser"
    open-maximized-to-edges true
}

window-rule {
    match app-id="^brave-browser$"
    open-on-workspace "browser"
    open-maximized-to-edges true
}

window-rule {
    match app-id="^vesktop$"
    exclude app-id="^vesktop$" title="^vesktop$"
    open-on-workspace "chat"
    open-maximized-to-edges true
}

// Vesktop splash/loading window
window-rule {
    match app-id="^vesktop$" title="^vesktop$"
    open-on-workspace "chat"
    open-floating true
}

window-rule {
    match app-id="^com\\.microsoft\\.VSCode$"
    open-on-workspace "editor"
    open-maximized-to-edges true
}

// VS Code dialogs still use the old "code" app-id
window-rule {
    match app-id="^code$"
    open-floating true
}

window-rule {
    match app-id="^at\\.yrlf\\.wl_mirror$"
    open-fullscreen true
}

window-rule {
    match app-id="^dev\\.noctalia\\.Noctalia$" title="^Noctalia Settings$"
    open-floating true
    default-window-height { proportion 0.95; }
}

window-rule {
    match app-id="^kitty-floating$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 600; }
}

// Polkit password dialog: float so it stacks above floating windows (e.g. Noctalia Settings)
window-rule {
    match app-id="^polkit-gnome-authentication-agent-1$"
    open-floating true
    open-focused true
}

// Terminals spawned to run pkexec (e.g. Noctalia greeter sync)
window-rule {
    match app-id="^kitty$" title="pkexec"
    open-floating true
    open-focused true
    default-column-width { fixed 1000; }
    default-window-height { fixed 600; }
}
